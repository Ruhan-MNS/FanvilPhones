@implements IDisposable

<button type="@Type" class="@($"{Class} {(IsBusy ? "is-busy" : "")}")" disabled="@(Disabled || IsBusy || !RendererInfo.IsInteractive)"
        aria-busy="@(IsBusy ? "true" : "false")" @attributes="AdditionalAttributes" @onclick="ClickAsync">
    @if (IsBusy) { <span class="busy-spinner" aria-hidden="true"></span> }
    else if (!string.IsNullOrWhiteSpace(Icon)) { <RadzenIcon Icon="@Icon" aria-hidden="true" /> }
    @if (!string.IsNullOrWhiteSpace(Text)) { <span>@(IsBusy ? BusyText ?? Text : Text)</span> }
</button>
@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Class { get; set; } = "button";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? BusyText { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private bool running;
    private bool disposed;
    private bool IsBusy => Busy || running;
    private async Task ClickAsync()
    {
        if (IsBusy || Disabled || !OnClick.HasDelegate) return;
        running = true;
        try { await OnClick.InvokeAsync(); }
        finally
        {
            running = false;
            // ComponentBase does not schedule the normal completion render for a faulted event.
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }
    public void Dispose() => disposed = true;
}
