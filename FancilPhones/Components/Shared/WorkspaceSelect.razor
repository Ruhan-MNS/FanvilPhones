@typeparam TValue
@using System.Linq.Expressions

<RadzenDropDown TValue="TValue" Data="@Options" TextProperty="Text" ValueProperty="Value"
                Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression"
                Class="@($"workspace-select {Class}")" Disabled="@(Disabled || !RendererInfo.IsInteractive)"
                AllowClear="false" PopupStyle="max-height:min(280px,50dvh);overflow-x:hidden"
                aria-label="@Label" InputAttributes="@_inputAttributes" @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired] public IEnumerable<SelectOption<TValue>> Options { get; set; } = [];
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValueExpression { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private IReadOnlyDictionary<string, object> _inputAttributes = new Dictionary<string, object>();
    protected override void OnParametersSet() => _inputAttributes = new Dictionary<string, object> { ["aria-label"] = Label };
}
