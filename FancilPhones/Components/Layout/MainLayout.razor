@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject UiFeedback Feedback

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="workspace @(_collapsed ? "workspace--compact" : "") @(_mobileOpen ? "workspace--mobile-open" : "")" @onkeydown="HandleKey">
    <header class="workspace-header">
        <div class="brand">
            <button type="button" class="icon-button desktop-only" disabled="@(!RendererInfo.IsInteractive)" aria-label="Toggle navigation" aria-expanded="@(!_collapsed)" @onclick="() => _collapsed = !_collapsed"><RadzenIcon Icon="menu_open" aria-hidden="true" /></button>
            <button type="button" class="icon-button mobile-only" disabled="@(!RendererInfo.IsInteractive)" aria-label="Toggle navigation" aria-expanded="@_mobileOpen" @onclick="() => _mobileOpen = !_mobileOpen"><RadzenIcon Icon="menu" aria-hidden="true" /></button>
            <a href="/" class="brand-link"><span class="brand-symbol"><RadzenIcon Icon="settings_phone" aria-hidden="true" /></span><span class="brand-copy"><strong>Fanvil Phones</strong><small>Multinet Systems</small></span></a>
        </div>
        <div class="workspace-location"><span>Voice workspace</span><strong>@_location</strong></div>
        <AuthorizeView Context="auth"><Authorized>
            <div class="account-area">
                <a class="account-link" href="/account/change-password"><span class="account-avatar">@(auth.User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")</span><span class="account-copy"><strong>@auth.User.Identity?.Name</strong><small>@(auth.User.IsInRole("BI-ADMIN") || auth.User.IsInRole("IT_ADMIN") ? "Administrator" : "Viewer")</small></span></a>
                <form method="post" action="/auth/logout"><AntiforgeryToken /><button type="submit" class="button button--quiet" title="Sign out"><RadzenIcon Icon="logout" aria-hidden="true" /><span>Sign out</span></button></form>
            </div>
        </Authorized></AuthorizeView>
    </header>
    @if (_mobileOpen) { <button class="nav-backdrop" aria-label="Close navigation" @onclick="() => _mobileOpen = false"></button> }
    <aside class="workspace-sidebar" aria-label="Workspace navigation"><NavMenu OnNavigate="CloseMobile" /></aside>
    <main id="main-content" class="workspace-main" tabindex="-1"><div class="page-container">@Body</div><footer class="workspace-footer"><span>Multinet Systems · Voice operations</span><span>Fanvil phone management</span></footer></main>
</div>
<FeedbackHost />
<div id="blazor-error-ui" data-nosnippet>Connection interrupted. <a href="." class="reload">Reload workspace</a><button type="button" class="dismiss" aria-label="Dismiss error">×</button></div>

@code {
    private bool _collapsed;
    private bool _mobileOpen;
    private string _location = "Overview";
    protected override void OnInitialized() { UpdateLocation(); Navigation.LocationChanged += LocationChanged; }
    private void UpdateLocation() => _location = new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant() switch
    { "phones" => "Phone fleet", "contacts" => "Phonebook", "sync" => "Synchronization", "logs" => "Activity log", "users" => "Account administration", "account/change-password" => "My account", _ => "Overview" };
    private void CloseMobile() => _mobileOpen = false;
    private void HandleKey(KeyboardEventArgs args) { if (args.Key == "Escape") _mobileOpen = false; }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    { UpdateLocation(); _mobileOpen = false; Feedback.Resolve(DialogChoice.Cancel); _ = InvokeAsync(StateHasChanged); }
    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
