@inherits AsyncComponentBase
@inject ILogger<Logs> Logger
@page "/logs"
@attribute [Authorize]
@inject IPhoneDirectory Directory
<PageTitle>Activity log · Fanvil Phones</PageTitle>
<PageHeader Title="Activity log" Description="Trace phonebook deliveries, connection probes, and SIP configuration changes."><button class="button" disabled="@(!RendererInfo.IsInteractive || (_loading))" @onclick="LoadAsync"><RadzenIcon Icon="refresh" aria-hidden="true" />Refresh activity</button></PageHeader>
@if (_error is not null) { <div class="alert alert--danger" role="alert">@_error <button class="text-button" @onclick="LoadAsync">Try again</button></div> }
<div class="section-heading"><div><h2>Recent events <span class="count-label">@_runs.Count</span></h2><p>Up to 500 latest records. Expand a message to see the full details.</p></div><span class="badge">@_runs.Count(r => r.Status is "Failed" or "Error") failed events</span></div>
<div class="table-toolbar"><div class="filter-fields"><label class="inline-field">Action<select @bind="_action" @bind:after="ResetPage"><option>All</option><option>Sync</option><option>Push</option><option>Probe</option></select></label><label class="inline-field">Result<select @bind="_status" @bind:after="ResetPage"><option>All</option><option>Success</option><option>Failed</option><option>Error</option><option>Running</option><option>Cancelled</option><option>TimedOut</option><option>Pending</option></select></label><button class="text-button" @onclick="ClearFilters" disabled="@(!RendererInfo.IsInteractive || FiltersAreClear)">Clear filters</button></div><label class="search-field"><RadzenIcon Icon="search" aria-hidden="true" /><input type="search" placeholder="Search phone, IP, message…" aria-label="Search activity" @bind="_search" @bind:event="oninput" @bind:after="ResetPage" /></label></div>
<div class="table-wrap" aria-busy="@_loading"><table class="log-table"><thead><tr><th scope="col">Started</th><th scope="col">Phone</th><th scope="col">Action</th><th scope="col">Result</th><th scope="col">HTTP</th><th scope="col">Duration</th><th scope="col">Details</th></tr></thead><tbody>
    @if (_loading) { <tr><td colspan="7" class="empty-cell">Loading activity…</td></tr> }
    else if (Filtered.Count == 0) { <tr><td colspan="7" class="empty-cell"><RadzenIcon Icon="receipt_long" aria-hidden="true" /><strong>@(_runs.Count == 0 ? "No activity recorded" : "No matching events")</strong><span>@(_runs.Count == 0 ? "Syncs, connection probes, and SIP changes will appear here." : "Change or clear your filters to see more activity.")</span></td></tr> }
    @foreach (var run in Paged) { <tr @key="run.Id"><td class="nowrap">@UiFormat.Date(run.StartedAt)</td><td><strong class="cell-title">@(run.Phone?.Name ?? "Deleted phone")</strong><small class="mono">@(run.Phone?.IpAddress ?? "—")</small></td><td><span class="badge">@run.Action</span></td><td><StatusBadge Status="@run.Status" /></td><td class="mono">@(run.HttpStatusCode?.ToString() ?? "—")</td><td class="nowrap">@UiFormat.Duration(run.StartedAt, run.FinishedAt)</td><td class="message-cell">@if (string.IsNullOrEmpty(run.Message)) { <span class="muted">No details recorded</span> } else if (run.Message.Length <= 100) { @run.Message } else { <details class="event-details"><summary>@(run.Message[..100] + "…")</summary><p>@run.Message</p></details> }</td></tr> }
</tbody></table></div><TablePager Total="@Filtered.Count" @bind-Page="_page" @bind-PageSize="_pageSize" />
@code {
    private List<SyncRun> _runs = [];
    private bool _loading = true;
    private string? _error;
    private string _action = "All", _status = "All", _search = "";
    private int _page = 1, _pageSize = 25;
    private List<SyncRun> Filtered => _runs.Where(r => (_action == "All" || r.Action == _action) && (_status == "All" || r.Status == _status) && (string.IsNullOrWhiteSpace(_search) || new[] { r.Phone?.Name, r.Phone?.IpAddress, r.Message }.Any(s => s?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true))).ToList();
    private IEnumerable<SyncRun> Paged => Filtered.Skip((Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / _pageSize))) - 1) * _pageSize).Take(_pageSize);
    private bool FiltersAreClear => string.IsNullOrEmpty(_search) && _status == "All" && _action == "All";
    private void ResetPage() => _page = 1;
    private void ClearFilters() { _action = _status = "All"; _search = ""; ResetPage(); }
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { if (!TryBeginLoad()) return; _loading = true; _error = null; try { _runs = await Directory.GetHistoryAsync(500, LifetimeToken); ResetPage(); } catch (OperationCanceledException) when (LifetimeToken.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load handset activity history."); _error = "Activity could not be loaded. Please try again."; } finally { _loading = false; EndLoad(); } }
}
