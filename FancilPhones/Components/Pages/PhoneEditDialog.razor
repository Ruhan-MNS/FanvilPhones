@inherits AsyncComponentBase
@inject ILogger<PhoneEditDialog> Logger
@inject IPhoneDirectory Directory
@inject UiFeedback Feedback
<AppDialog Open="true" Title="@(Model.Id == 0 ? "Add phone" : "Edit phone")" Description="Configure how this workspace connects to the handset." Busy="@_busy" OnClose="OnCancel">
    <EditForm Model="Model" OnValidSubmit="SaveAsync" FormName="phone-editor">
        <DataAnnotationsValidator />
        <div class="dialog-body"><ValidationSummary />
            @if (_error is not null) { <div class="alert alert--danger" role="alert">@_error</div> }
            <fieldset disabled="@_busy"><legend>Handset & network</legend><div class="form-grid">
                <label class="field field--wide">Phone name<TextFieldInput @bind-Value="Model.Name" placeholder="Reception" required maxlength="100" /><ValidationMessage For="() => Model.Name" /></label>
                <label class="field">IP address<TextFieldInput @bind-Value="Model.IpAddress" placeholder="192.168.55.101" required maxlength="64" /><ValidationMessage For="() => Model.IpAddress" /></label>
                <div class="field"><span>Connection</span><WorkspaceSelect TValue="string" Options="ConnectionOptions" @bind-Value="Model.Scheme" Label="Handset connection protocol" Disabled="_busy" /></div>
                <label class="check-row field--wide"><InputCheckbox @bind-Value="Model.Enabled" /><span><strong>Include in fleet sync</strong><small>Enabled handsets receive the shared phonebook.</small></span></label>
            </div></fieldset>
            <fieldset disabled="@_busy"><legend>Handset access</legend><div class="form-grid">
                <label class="field">Username<TextFieldInput @bind-Value="Model.Username" autocomplete="off" maxlength="64" /></label>
                <div class="field"><label for="handset-password">Password</label><div class="password-field"><TextFieldInput id="handset-password" @bind-Value="Model.Password" type="@(_showPassword ? "text" : "password")" autocomplete="new-password" maxlength="128" /><button type="button" class="icon-button" aria-label="@(_showPassword ? "Hide handset password" : "Show handset password")" aria-pressed="@_showPassword" @onclick="() => _showPassword = !_showPassword"><RadzenIcon Icon="@(_showPassword ? "visibility_off" : "visibility")" aria-hidden="true" /></button></div></div>
                <label class="field">Upload path<TextFieldInput @bind-Value="Model.UploadPath" maxlength="256" /><small>Usually /pBookAdv.htm</small></label><label class="field">Upload field name<TextFieldInput @bind-Value="Model.UploadFieldName" maxlength="64" /><small>Usually PHONEBOOK</small></label>
            </div></fieldset>
            <fieldset disabled="@_busy"><legend>SIP identity <span class="muted">Optional</span></legend><p class="field-hint">Save these values here, then use “Push SIP settings” to apply them to the phone.</p><div class="form-grid">
                <label class="field">Display name<TextFieldInput @bind-Value="Model.SipDisplayName" placeholder="Reception" maxlength="64" /></label><label class="field">Line number<InputNumber @bind-Value="Model.SipLineIndex" min="1" max="16" /></label>
                <label class="field field--wide">Extension / phone number<TextFieldInput @bind-Value="Model.SipExtension" placeholder="144" maxlength="32" /><small>Used for both Username and Authentication User on the handset.</small></label>
                <label class="check-row field--wide"><InputCheckbox @bind-Value="Model.SipRegistrationEnabled" /><span><strong>Enable SIP registration</strong><small>Activate the line when these settings are pushed.</small></span></label>
            </div></fieldset>
        </div>
        <footer class="dialog-footer"><button type="button" class="button" disabled="@_busy" @onclick="OnCancel">Cancel</button><button type="submit" class="button button--primary" disabled="@_busy"><RadzenIcon Icon="save" aria-hidden="true" />@(_busy ? "Saving…" : "Save phone")</button></footer>
    </EditForm>
</AppDialog>
@code {
    private static readonly SelectOption<string>[] ConnectionOptions = [new("http", "HTTP"), new("https", "HTTPS")];
    [Parameter, EditorRequired] public Phone Model { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private bool _busy, _showPassword;
    private string? _error;
    private async Task SaveAsync()
    {
        if (_busy || IsDisposed) return;
        if (Model.SipLineIndex is < 1 or > 16) { _error = "Choose a SIP line between 1 and 16."; return; }
        _busy = true; _error = null;
        try { await Directory.SavePhoneAsync(Model, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify($"Saved {Model.Name}.", "success"); await OnSaved.InvokeAsync(); }
        catch (DuplicatePhoneException ex) { _error = ex.Message; }
        catch (OperationCanceledException) when (LifetimeToken.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save phone {PhoneId}.", Model.Id); _error = "The phone could not be saved. Check its details and try again."; }
        finally { _busy = false; }
    }
}
