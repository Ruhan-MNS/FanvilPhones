@inject ILogger<Home> Logger
@page "/"
@attribute [Authorize]
@inject IPhoneDirectory Directory

<PageTitle>Overview · Fanvil Phones</PageTitle>
<PageHeader Title="Phone operations" Description="A clear view of your handsets, shared phonebook, and latest deliveries.">
    <button class="button" @onclick="LoadAsync" disabled="@(!RendererInfo.IsInteractive || (_loading))"><RadzenIcon Icon="refresh" aria-hidden="true" />Refresh overview</button>
    <a class="button button--primary" href="/phones"><RadzenIcon Icon="phone_in_talk" aria-hidden="true" />Open phone fleet</a>
</PageHeader>
@if (_error is not null) { <div class="alert alert--danger" role="alert">@_error <button class="text-button" @onclick="LoadAsync">Try again</button></div> }
<section class="section-block" aria-labelledby="glance-title">
    <div class="section-heading"><div><h2 id="glance-title">At a glance</h2><p>Current fleet and phonebook status</p></div><span class="muted small">@(_loading ? "Loading fleet…" : $"Updated {_updatedAt:HH:mm}")</span></div>
    <div class="metric-strip">
        <a class="metric" href="/phones"><RadzenIcon Icon="devices" aria-hidden="true" /><strong>@Value(_phones.Count)</strong><span>Configured phones</span></a>
        <a class="metric" href="/phones"><RadzenIcon Icon="power_settings_new" aria-hidden="true" /><strong>@Value(_phones.Count(p => p.Enabled))</strong><span>Enabled for sync</span></a>
        <a class="metric" href="/contacts"><RadzenIcon Icon="contacts" aria-hidden="true" /><strong>@Value(_contactCount)</strong><span>Shared contacts</span></a>
        <a class="metric metric--warning" href="/phones"><RadzenIcon Icon="error_outline" aria-hidden="true" /><strong>@Value(Attention.Count)</strong><span>Need attention</span></a>
    </div>
</section>
<div class="overview-grid">
    <section class="panel" aria-labelledby="delivery-title">
        <div class="panel-heading"><div><h2 id="delivery-title">Phonebook delivery</h2><p>Latest recorded result for each handset</p></div><span class="badge">Fleet status</span></div>
        <div class="panel-body">
            <div class="coverage-heading"><span class="large-number">@Value(SuccessCount)<small>/ @_phones.Count</small></span><span class="muted">phones last synced<br /><strong class="text-success">successfully</strong></span></div>
            <div class="coverage-bar" role="img" aria-label="@($"{SuccessCount} successful, {Attention.Count} need attention, {PendingCount} never synced, {DisabledCount} disabled")">
                @if (_phones.Count > 0) {
                    <span class="coverage--success" style="flex:@SuccessCount"></span><span class="coverage--danger" style="flex:@Attention.Count"></span><span class="coverage--pending" style="flex:@PendingCount"></span><span class="coverage--disabled" style="flex:@DisabledCount"></span>
                }
            </div>
            <div class="legend"><span><i class="swatch swatch--success"></i>Successful <strong>@SuccessCount</strong></span><span><i class="swatch swatch--danger"></i>Attention <strong>@Attention.Count</strong></span><span><i class="swatch swatch--pending"></i>Never synced <strong>@PendingCount</strong></span><span><i class="swatch swatch--disabled"></i>Disabled <strong>@DisabledCount</strong></span></div>
        </div>
        <div class="panel-footer"><span>Last activity <strong>@UiFormat.Date(_lastActivity)</strong></span><a href="/sync" class="text-link">Synchronization <RadzenIcon Icon="arrow_forward" aria-hidden="true" /></a></div>
    </section>
    <section class="panel workflow-panel" aria-labelledby="workflow-title"><div class="panel-heading"><div><h2 id="workflow-title">Keep every phone in step</h2><p>Your phonebook workflow</p></div><RadzenIcon Icon="route" aria-hidden="true" /></div>
        <ol class="workflow"><li><span>01</span><div><a href="/contacts">Maintain the phonebook</a><p>Add contacts or import your master CSV.</p></div></li><li><span>02</span><div><a href="/phones">Review your fleet</a><p>Check enabled handsets and connection details.</p></div></li><li><span>03</span><div><a href="/sync">Sync and verify</a><p>Deliver the directory, then review the results.</p></div></li></ol>
    </section>
</div>
<section class="section-block" aria-labelledby="attention-title">
    <div class="section-heading"><div><h2 id="attention-title">Handsets to review <span class="count-label">@(Attention.Count + PendingCount)</span></h2><p>Failed deliveries and enabled phones waiting for their first sync</p></div><a class="text-link" href="/phones">View all phones <RadzenIcon Icon="arrow_forward" aria-hidden="true" /></a></div>
    <div class="table-wrap"><table><thead><tr><th scope="col">Phone</th><th scope="col">Network address</th><th scope="col">Status</th><th scope="col">Last delivery</th><th scope="col">Details</th></tr></thead><tbody>
    @if (_loading) { <tr><td colspan="5" class="empty-cell">Loading handset status…</td></tr> }
    else if (!ReviewPhones.Any()) { <tr><td colspan="5" class="empty-cell"><RadzenIcon Icon="check_circle" aria-hidden="true" /><strong>No handsets need review</strong><span>Enabled phones have successful recorded deliveries, or your fleet is empty.</span></td></tr> }
    @foreach (var phone in ReviewPhones.Take(5)) { <tr><td><a class="cell-title" href="/phones">@phone.Name</a><small>Extension @(phone.SipExtension ?? "not set")</small></td><td class="mono">@phone.IpAddress</td><td><StatusBadge Status="@(phone.LastSyncedAt is null ? "Pending" : phone.LastSyncStatus)" /></td><td class="nowrap">@UiFormat.Date(phone.LastSyncedAt)</td><td class="message-cell">@(phone.LastSyncMessage ?? "Ready for its first phonebook sync.")</td></tr> }
    </tbody></table></div>
</section>
<section class="section-block" aria-labelledby="recent-title"><div class="section-heading"><div><h2 id="recent-title">Recent activity</h2><p>The latest actions across your fleet</p></div><a class="text-link" href="/logs">Activity log <RadzenIcon Icon="arrow_forward" aria-hidden="true" /></a></div>
    <div class="table-wrap"><table><thead><tr><th scope="col">Phone</th><th scope="col">Action</th><th scope="col">Result</th><th scope="col">Started</th><th scope="col">Duration</th></tr></thead><tbody>
        @if (_history.Count == 0) { <tr><td colspan="5" class="empty-cell">@(_loading ? "Loading activity…" : "No activity yet. Syncs, probes, and SIP changes will appear here.")</td></tr> }
        @foreach (var run in _history) { <tr><td class="cell-title">@(run.Phone?.Name ?? "Deleted phone")</td><td>@run.Action</td><td><StatusBadge Status="@run.Status" /></td><td class="nowrap">@UiFormat.Date(run.StartedAt)</td><td>@UiFormat.Duration(run.StartedAt, run.FinishedAt)</td></tr> }
    </tbody></table></div>
</section>
@code {
    private List<Phone> _phones = [];
    private List<SyncRun> _history = [];
    private int _contactCount;
    private DateTime? _lastActivity;
    private DateTime _updatedAt;
    private bool _loading = true;
    private string? _error;
    private List<Phone> Attention => _phones.Where(p => p.Enabled && p.LastSyncedAt is not null && p.LastSyncStatus != "Success").ToList();
    private int PendingCount => _phones.Count(p => p.Enabled && p.LastSyncedAt is null);
    private int DisabledCount => _phones.Count(p => !p.Enabled);
    private int SuccessCount => _phones.Count(p => p.Enabled && p.LastSyncedAt is not null && p.LastSyncStatus == "Success");
    private IEnumerable<Phone> ReviewPhones => Attention.Concat(_phones.Where(p => p.Enabled && p.LastSyncedAt is null));
    private string Value(int value) => _loading ? "—" : value.ToString();
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try { var summary = await Directory.GetSummaryAsync(); _contactCount = summary.ContactCount; _lastActivity = summary.LastActivity; _phones = await Directory.GetPhonesAsync(); _history = await Directory.GetHistoryAsync(5); _updatedAt = DateTime.Now; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load the fleet overview."); _error = "The fleet could not be loaded. Please try again."; }
        finally { _loading = false; }
    }
}
