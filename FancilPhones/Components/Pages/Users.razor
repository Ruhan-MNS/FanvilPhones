@page "/users"
@attribute [Authorize(Policy = PhonePolicies.Administrator)]
<PageTitle>Account administration</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Account administration</MudText>
<MudAlert Severity="Severity.Info">Accounts and role assignments are managed centrally in ASP Auth, using the same employee accounts as BIDevHub. Contact your identity administrator to create an account, reset a password, or change access.</MudAlert>
<MudText Class="mt-4">BI-ADMIN and IT_ADMIN can manage phones, contacts, and syncs. Other signed-in users have view access and can probe existing phones.</MudText>
