@inject ILogger<ScanNetworkDialog> Logger
@inherits AsyncComponentBase
@inject IPhoneDiscoveryService Discovery
@inject IPhoneDirectory Directory
<AppDialog Open="true" Title="Discover phones" Description="Scan an internal network range for Fanvil handsets." OnClose="CloseAsync">
    <div class="dialog-body">
        <div class="scan-controls"><label class="field">IP address or range<input @bind="_range" @bind:event="oninput" disabled="@_scanning" placeholder="192.168.55.0/24" /><small>IPv4, CIDR, or a range such as 192.168.55.1–254 (use a hyphen).</small></label>
        @if (_scanning) { <button class="button button--danger" @onclick="CancelScan"><RadzenIcon Icon="stop" aria-hidden="true" />Stop scan</button> } else { <button class="button button--primary" @onclick="StartScanAsync"><RadzenIcon Icon="radar" aria-hidden="true" />Start scan</button> }</div>
        @if (_error is not null) { <div class="alert alert--danger" role="alert">@_error</div> }
        @if (_total > 0) { <div class="scan-progress"><progress value="@_done" max="@_total" aria-label="Network scan progress"></progress><p>@_done / @_total addresses checked <span class="badge badge--success">@_results.Count(r => r.IsFanvil && !r.AlreadyKnown) new phones</span></p></div> }
        <div class="table-wrap scan-results"><table><thead><tr><th scope="col">Add</th><th scope="col">IP address</th><th scope="col">Status</th><th scope="col">Phone name</th></tr></thead><tbody>
            @if (!_results.Any(r => r.IsFanvil)) { <tr><td colspan="4" class="empty-cell">@(_scanning ? "Looking for Fanvil handsets…" : _total == 0 ? "Start a scan to discover phones on your network." : "No Fanvil phones found in this range.")</td></tr> }
            @foreach (var phone in _results.Where(r => r.IsFanvil)) { <tr @key="phone.Ip"><td><input type="checkbox" checked="@_selected.Contains(phone.Ip)" disabled="@phone.AlreadyKnown" aria-label="@($"Select {phone.Ip}")" @onchange="args => ToggleSelect(phone, args.Value is true)" /></td><td class="mono">@phone.Ip</td><td><span class="badge @(phone.AlreadyKnown ? "" : "badge--success")">@(phone.AlreadyKnown ? "Already added" : "Fanvil detected")</span></td><td>@if (!phone.AlreadyKnown) { <input value="@GetName(phone.Ip)" @oninput="args => SetName(phone.Ip, args.Value?.ToString() ?? phone.Ip)" aria-label="@($"Name for {phone.Ip}")" maxlength="100" /> } else { <span class="muted">Already in your fleet</span> }</td></tr> }
        </tbody></table></div>
    </div>
    <footer class="dialog-footer"><button class="button" @onclick="CloseAsync">Close</button><button class="button button--primary" disabled="@(_selected.Count == 0 || _scanning)" @onclick="AddSelectedAsync"><RadzenIcon Icon="add" aria-hidden="true" />Add selected (@_selected.Count)</button></footer>
</AppDialog>
@code {
    [Parameter] public EventCallback<List<Phone>> OnAdded { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private string? _error;

    private string _range = "192.168.55.0/24";
    private bool _scanning;
    private int _total;
    private int _done;
    private readonly List<DiscoveredPhone> _results = new();
    private readonly HashSet<string> _selected = new();
    private readonly Dictionary<string, string> _names = new();
    private CancellationTokenSource? _cts;

    private string GetName(string ip) => _names.TryGetValue(ip, out var n) ? n : ip;
    private void SetName(string ip, string value) => _names[ip] = value;

    private void ToggleSelect(DiscoveredPhone p, bool selected)
    {
        if (p.AlreadyKnown) return;
        if (selected) _selected.Add(p.Ip);
        else _selected.Remove(p.Ip);
    }

    private async Task StartScanAsync()
    {
        if (_scanning || IsDisposed) return;
        _results.Clear();
        _selected.Clear();
        _names.Clear();
        _done = 0;
        _error = null;
        _total = PhoneNetworkRange.EnumerateIps(_range).Take(4097).Count();
        if (_total > 4096) { _error = "Choose a range with 4,096 addresses or fewer."; _total = 0; return; }
        if (_total == 0) { _error = "Enter a valid IPv4 address, CIDR subnet, or IP range."; return; }

        _scanning = true;
        using var scan = CancellationTokenSource.CreateLinkedTokenSource(LifetimeToken);
        _cts = scan;
        var token = scan.Token;
        var lastRender = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            var known = new HashSet<string>(
                (await Directory.GetPhonesAsync(token)).Select(p => p.IpAddress), StringComparer.OrdinalIgnoreCase);
            await foreach (var result in Discovery.ScanAsync(_range, known, ct: token))
            {
                _done++;
                _results.Add(result);
                if (result.IsFanvil && !result.AlreadyKnown)
                {
                    _selected.Add(result.Ip);
                    _names[result.Ip] = result.Ip;
                }
                if (!IsDisposed && lastRender.ElapsedMilliseconds >= 100) { StateHasChanged(); lastRender.Restart(); }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "Network discovery could not complete."); _error = "The scan could not be completed. Check the range and try again."; }
        finally
        {
            _scanning = false;
            _cts = null;
            if (!IsDisposed) StateHasChanged();
        }
    }

    private void CancelScan() => _cts?.Cancel();

    private async Task AddSelectedAsync()
    {
        var picks = _results
            .Where(r => r.IsFanvil && !r.AlreadyKnown && _selected.Contains(r.Ip))
            .Select(r => new Phone
            {
                Name = (_names.TryGetValue(r.Ip, out var n) && !string.IsNullOrWhiteSpace(n)) ? n.Trim() : r.Ip,
                IpAddress = r.Ip,
            })
            .ToList();
        await OnAdded.InvokeAsync(picks);
    }

    private async Task CloseAsync() { CancelScan(); await OnCancel.InvokeAsync(); }

}
