@page "/sync"
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PhoneSyncService SyncSvc
@inject ISnackbar Snackbar

<PageTitle>Sync</PageTitle>

<div class="fp-section-header">
    <span class="fp-section-icon" style="background: rgba(245, 158, 11, 0.14); color: #B45309;">
        <MudIcon Icon="@Icons.Material.Filled.CloudSync" />
    </span>
    <MudText Typo="Typo.h4">Sync</MudText>
</div>
<div class="fp-section-subtitle">Push the current master phonebook to every enabled handset.</div>

<MudPaper Elevation="0" Class="pa-5 mb-4 fp-card-surface">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.CloudUpload"
                           Disabled="_running" OnClick="RunAsync">
                    @(_running ? "Syncing..." : "Sync all enabled phones")
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Read-only view. Ask an admin to run a sync.
                </MudAlert>
            </NotAuthorized>
        </AuthorizeView>
        <MudText Class="mud-text-secondary">@_summary</MudText>
    </MudStack>
    @if (_running)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" Rounded="true" />
    }
</MudPaper>

@if (_results.Count > 0)
{
    <MudText Typo="Typo.h6" Class="mt-2 mb-2">This run</MudText>
    <div class="fp-table-wrap mb-4">
    <MudTable Items="_results" Dense="true" Hover="true" Bordered="false" Elevation="0">
        <HeaderContent>
            <MudTh>Phone</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>HTTP</MudTh>
            <MudTh>Message</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.PhoneName</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Success ? Color.Success : Color.Error)">
                    @(context.Success ? "Success" : "Failed")
                </MudChip>
            </MudTd>
            <MudTd>@context.HttpStatus</MudTd>
            <MudTd>@context.Message</MudTd>
        </RowTemplate>
    </MudTable>
    </div>
}

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Recent sync history</MudText>
<div class="fp-table-wrap">
<MudTable Items="_history" Dense="true" Hover="true" Bordered="false" Elevation="0">
    <HeaderContent>
        <MudTh>Started</MudTh>
        <MudTh>Phone</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Contacts</MudTh>
        <MudTh>Message</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.StartedAt.ToLocalTime().ToString("g")</MudTd>
        <MudTd>@(context.Phone?.Name ?? "?")</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@HistoryStatusColor(context.Status)">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd>@context.ContactCount</MudTd>
        <MudTd>@context.Message</MudTd>
    </RowTemplate>
</MudTable>
</div>

@code {
    private static Color HistoryStatusColor(string? s) => s switch
    {
        "Success" => Color.Success,
        "Failed" => Color.Warning,
        "Error" => Color.Error,
        _ => Color.Default
    };

    private bool _running;
    private string _summary = "";
    private List<SyncResult> _results = new();
    private List<SyncRun> _history = new();

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    private async Task LoadHistoryAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _history = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
            .ToListAsync(
                Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                    .Include(db.SyncRuns, r => r.Phone)
                    .OrderByDescending(r => r.StartedAt)
                    .Take(50));
    }

    private async Task RunAsync()
    {
        _running = true;
        _summary = "Pushing phonebook to all enabled phones...";
        try
        {
            var rs = await SyncSvc.SyncAllAsync();
            _results = rs.ToList();
            var ok = _results.Count(r => r.Success);
            _summary = $"{ok} of {_results.Count} phones succeeded.";
            Snackbar.Add(_summary, ok == _results.Count ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            _summary = "Error: " + ex.Message;
            Snackbar.Add(_summary, Severity.Error);
        }
        finally
        {
            _running = false;
            await LoadHistoryAsync();
        }
    }
}
