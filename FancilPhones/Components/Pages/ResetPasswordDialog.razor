@* Dialog: reset another user's password. Returns the new password string. *@

<MudDialog Class="fp-phone-dialog">
    <TitleContent>
        <div style="display: flex; align-items: center; gap: 12px;">
            <span class="fp-section-icon" style="background: rgba(245, 158, 11, 0.14); color: #B45309;">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" />
            </span>
            <div style="display: flex; flex-direction: column;">
                <MudText Typo="Typo.h6" Style="line-height: 1.2;">Reset password</MudText>
                <MudText Typo="Typo.caption" Style="color: #6B7280;">
                    The user will be asked to change it on their next login.
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_password" Label="New password" Required="true"
                      InputType="@(_show ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="Minimum 4 characters."
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _show = !_show)" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Ok" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save">Reset</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string _password = "";
    private bool _show;

    private void Ok()
    {
        if (string.IsNullOrWhiteSpace(_password)) return;
        MudDialog.Close(DialogResult.Ok(_password));
    }
}
