@page "/switchboards"
@inherits AsyncComponentBase
@attribute [Authorize(Policy = PhonePolicies.Administrator)]
@inject ISwitchboardService Keys
@inject UiFeedback Feedback
@inject ILogger<Switchboards> Logger

<PageTitle>Switchboard keys · Fanvil Phones</PageTitle>
<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<div class="sb-workspace">
<PageHeader Title="Switchboard keys" Eyebrow="Voice operations" Description="Edit one layout. Sync the phones you choose."><AsyncButton Text="Refresh" Icon="refresh" Disabled="@Dirty" Busy="_busy" OnClick="RefreshAsync" /></PageHeader>
@if (!string.IsNullOrEmpty(_error)) { <div class="alert alert--danger" role="alert"><RadzenIcon Icon="error" aria-hidden="true" /><span>@_error</span></div> }
<LoadingState Visible="_busy" Text="@_working" />
<div class="sb-workbench">
    <aside class="sb-phones" aria-labelledby="sb-phones-title">
        <header class="sb-panel-heading"><span class="sb-kicker">01 / CHOOSE PHONES</span><h2 id="sb-phones-title">Your switchboards <span class="count-label">@_state.Phones.Count</span></h2><p>Add a phone from your fleet, then choose one to edit.</p></header>
        <div class="sb-add-phone"><label class="field"><span>Phone fleet</span><WorkspaceSelect TValue="int" Options="FleetOptions" @bind-Value="_addPhone" Label="Add switchboard from phone fleet" Disabled="@(Disabled || Dirty)" /></label><AsyncButton Text="Add phone" Icon="add" Class="button sb-full" Disabled="@(Disabled || Dirty || _addPhone == 0)" OnClick="AddPhoneAsync" /><small>Reads all five pages to check compatibility. Standard two-key phones cannot be added.</small></div>
        @if (_state.Phones.Count > 0)
        {
            <div class="sb-list-heading"><span>@_selected.Count selected for sync</span><button type="button" class="text-button" disabled="@Disabled" @onclick="SelectAll">@(_selected.Count == EligiblePhones.Count() ? "Clear" : "Select all")</button></div>
            <div class="sb-phone-list">
            @foreach (var phone in _state.Phones)
            {
                var enabled = _state.FleetPhones.Any(p => p.Id == phone.Id && p.Enabled);
                <div class="sb-phone @(phone.Id == _editor?.PhoneId ? "is-active" : "")"><input type="checkbox" aria-label="@($"Sync {phone.Name}")" checked="@_selected.Contains(phone.Id)" disabled="@(Disabled || !enabled)" @onchange="e => Select(phone.Id, e.Value is true)" /><button type="button" class="sb-phone-open" aria-label="@($"Edit keys for {phone.Name}")" aria-pressed="@(phone.Id == _editor?.PhoneId)" disabled="@(Disabled || !enabled || Dirty && phone.Id != _editor?.PhoneId)" @onclick="() => OpenAsync(phone.Id)"><strong>@phone.Name</strong><span class="mono">@phone.IpAddress</span><small>@(!enabled ? "Disabled in fleet" : phone.ConfigurationWarning is not null ? "Needs attention" : phone.HasDraft ? "Saved layout" : "Keys captured")</small></button><RadzenIcon Icon="chevron_right" aria-hidden="true" /></div>
            }
            </div><p class="sb-sidebar-note">Checkboxes choose sync targets. Click a phone's name to edit its layout.</p>
        }
        else { <div class="sb-empty"><RadzenIcon Icon="deskphone" aria-hidden="true" /><strong>Add your first switchboard</strong><p>Existing fleet credentials are used to read its keys.</p><a href="/phones">Open Phone fleet</a></div> }
    </aside>

    <section class="sb-editor" aria-labelledby="sb-editor-title">
    @if (_editor is not null)
    {
        var phone = _state.Phones.Single(p => p.Id == _editor.PhoneId);
        <header class="sb-editor-heading"><div><span class="sb-kicker">02 / EDIT LAYOUT</span><h2 id="sb-editor-title">@phone.Name</h2><p class="mono">@phone.IpAddress <span>· Read @UiFormat.Date(phone.CapturedAt)</span></p></div><span class="sb-draft-state @(Dirty ? "is-dirty" : "")"><span></span>@(Dirty ? "Unsaved changes" : _editor.Layout.Fingerprint() != _editor.Baseline.Fingerprint() ? "Saved · not synced" : "Matches last read")</span></header>
        @if (phone.ConfigurationWarning is not null) { <div class="sb-warning"><RadzenIcon Icon="warning" aria-hidden="true" /><div><strong>Check this layout</strong><p>@phone.ConfigurationWarning</p></div></div> }
        <div class="sb-editor-toolbar"><div class="sb-pages" aria-label="Key pages">@for (var n = 1; n <= 5; n++) { var p = n; <button type="button" disabled="@(!RendererInfo.IsInteractive)" class="@(_page == p ? "is-active" : "")" aria-pressed="@(_page == p)" @onclick="() => _page = p">Page @p</button> }</div><div class="sb-tools"><button type="button" class="button" disabled="@(Disabled || !HasEmpty)" @onclick="AddKey"><RadzenIcon Icon="add" aria-hidden="true" />Add key</button><button type="button" class="button" disabled="@Disabled" @onclick="SortKeys"><RadzenIcon Icon="sort_by_alpha" aria-hidden="true" />Sort A–Z</button></div></div>
        <div class="sb-layout-hint"><RadzenIcon Icon="tune" aria-hidden="true" /><span>All 60 keys are editable, including F1 and F2. Use key settings for type-specific options.</span></div>
        <div class="table-wrap sb-key-table"><table><thead><tr><th>Key</th><th>Type</th><th>Name</th><th>Value</th><th>Value2</th><th class="align-right">Edit</th></tr></thead><tbody>
        @foreach (var key in _editor.Layout.Keys.Where(k => k.Page == _page).OrderBy(k => k.Slot))
        {
            <tr @key="(key.Page, key.Slot)" ><td><span class="sb-key-number">@($"F{key.Slot}")</span></td>
                <td><WorkspaceSelect TValue="string" Options="TypeOptions(key)" Value="@key.Get("Type")" ValueChanged="v => ChangeType(key, v)" Label="@($"Page {key.Page} F{key.Slot} type")" Disabled="@Disabled" /></td>
                <td><input aria-label="@($"Page {key.Page} F{key.Slot} name")" value="@key.Name" maxlength="63" placeholder="@(key.Get("Type") == "0" ? "Empty key" : "Name")" disabled="@(Disabled)" @oninput='e => ChangeText(key, "Title", e)' /></td>
                <td><input aria-label="@($"Page {key.Page} F{key.Slot} value")" value="@key.Extension" maxlength="@SwitchboardKeyOptions.ValueLimit(key)" disabled="@(Disabled || !SwitchboardKeyOptions.HasValue(key))" @oninput="e => ChangeNumber(key, e, false)" /></td>
                <td><input aria-label="@($"Page {key.Page} F{key.Slot} Value2")" value="@key.Value2" maxlength="@SwitchboardKeyOptions.ValueLimit(key)" disabled="@(Disabled || !SwitchboardKeyOptions.HasValue(key))" @oninput="e => ChangeNumber(key, e, true)" /></td>
                <td><div class="row-actions"><button type="button" class="icon-button" aria-label="@($"More settings for Page {key.Page} F{key.Slot}")" title="All key settings" disabled="@Disabled" @onclick="() => _editingKey = key"><RadzenIcon Icon="tune" aria-hidden="true" /></button><button type="button" class="icon-button" aria-label="@($"Clear Page {key.Page} F{key.Slot}")" title="Clear key" disabled="@(Disabled || key.Get("Type") == "0")" @onclick='() => ChangeType(key, "0")'><RadzenIcon Icon="close" aria-hidden="true" /></button></div></td>
            </tr>
        }
        </tbody></table></div>
        <div class="sb-editor-options"><label class="check-row"><input type="checkbox" @bind="_alphabetical" @bind:after="Invalidate" disabled="@Disabled" /><span>Sort Memory Keys A–Z when saving <small>Reorders all five pages. F1/F2, Line and special keys stay in place.</small></span></label><span>@_editor.Layout.Keys.Count(k => k.Get("Type") != "0") / 60 positions used</span></div>
        <footer class="sb-editor-footer"><div class="sb-tools"><AsyncButton Text="Read from phone" Icon="download" Disabled="@(Disabled || Dirty)" OnClick="ReadPhoneAsync" /><AsyncButton Text="Remove" Icon="remove_circle" Disabled="@(Disabled || Dirty)" OnClick="RemovePhoneAsync" /></div><div class="sb-tools"><AsyncButton Text="Discard edits" Disabled="@(Disabled || !Dirty)" OnClick="DiscardAsync" /><AsyncButton Text="Save layout" Icon="save" Disabled="@(Disabled || !Dirty)" OnClick="SaveAsync" /><AsyncButton Text="Preview this phone" Icon="preview" Class="button button--primary" Disabled="@Disabled" OnClick="() => ReviewAsync([_editor.PhoneId])" /></div></footer>
    }
    else { <div class="sb-editor-welcome"><span class="sb-kicker">YOUR KEY WORKSPACE</span><RadzenIcon Icon="dialpad" aria-hidden="true" /><h2 id="sb-editor-title">A simpler way to manage every key.</h2><p>Add a switchboard from Phone fleet to edit its five pages here. Save changes for one phone or sync the same layout to a selected group.</p><div><span>01 <strong>Add a phone</strong></span><span>02 <strong>Edit its keys</strong></span><span>03 <strong>Review &amp; sync</strong></span></div></div> }
    </section>
</div>
@if (_editor is not null)
{
    <section class="sb-sync-bar" aria-label="Sync selected phones"><div><RadzenIcon Icon="sync" aria-hidden="true" /><div><strong>Use @PhoneName(_editor.PhoneId)'s layout on @_selected.Count selected phone@(_selected.Count == 1 ? "" : "s")</strong><p>Review every page before anything is sent to a handset.</p></div></div><label class="sb-keep-numbers"><input type="checkbox" checked="@_keepNumbers" disabled="@Disabled" @onchange="e => { _keepNumbers = e.Value is true; Invalidate(); }" /><span>Keep target phone numbers<small>Match existing Value and Value2 by name.</small></span></label><AsyncButton Text="Review selected phones" Icon="arrow_forward" Class="button button--primary" Disabled="@(Disabled || _selected.Count == 0)" OnClick="() => ReviewAsync(_selected.ToArray())" /></section>
}
@if (_previews.Count > 0 || _previewErrors.Count > 0)
{
    <section class="sb-review" aria-labelledby="sb-review-title"><header class="sb-section-heading"><div><span class="sb-kicker">03 / REVIEW &amp; SYNC</span><h2 id="sb-review-title">Review key changes</h2><p>Only the phones below receive this layout. Previews expire after 30 minutes.</p></div><div class="sb-tools">@if (_delivering) { <AsyncButton Text="Stop sync" Icon="stop" Class="button button--danger" OnClick="CancelDelivery" /> }<AsyncButton Text="Sync reviewed phones" Icon="send" Class="button button--primary" Disabled="@(Disabled || Dirty || _previewErrors.Count > 0 || _previews.Count == 0 || _previews.Any(p => p.Status != "Preview"))" OnClick="DeployAsync" /></div></header>
    @foreach (var error in _previewErrors) { <div class="alert alert--danger" role="alert">@error</div> }
    @foreach (var preview in _previews)
    {
        var before = SwitchboardLayout.FromJson(preview.BeforeJson);
        var target = SwitchboardLayout.FromJson(preview.TargetJson);
        var page = _previewPages.GetValueOrDefault(preview.Id, 1);
        <article class="sb-preview"><header><div><h3>@PhoneName(preview.PhoneId)</h3><span class="mono">@preview.IpAddress</span></div><div><span>@target.Keys.Count(k => Changed(k, before.Keys.Single(b => b.Page == k.Page && b.Slot == k.Slot))) changed keys</span><StatusBadge Status="@preview.Status" /></div></header><p>@preview.Message</p><div class="sb-preview-toolbar"><div class="sb-pages" aria-label="@($"Preview pages for {PhoneName(preview.PhoneId)}")">@for (var n = 1; n <= 5; n++) { var p = n; <button type="button" disabled="@(!RendererInfo.IsInteractive)" class="@(page == p ? "is-active" : "")" aria-pressed="@(page == p)" @onclick="() => _previewPages[preview.Id] = p">Page @p</button> }</div></div><div class="table-wrap"><table><thead><tr><th>Key</th><th>Before</th><th>After</th><th>Value2</th><th>Type / subtype</th><th>SIP line</th><th>Other settings</th><th>Change</th></tr></thead><tbody>
        @foreach (var key in target.Keys.Where(k => k.Page == page).OrderBy(k => k.Slot))
        {
            var old = before.Keys.Single(k => k.Page == key.Page && k.Slot == key.Slot);
            <tr class="@(Changed(key, old) ? "sb-key-changed" : "")"><td>@($"F{key.Slot}")</td><td><strong>@Display(old.Name)</strong><small class="mono">@Display(old.Get("Value"))</small><small>@old.TypeLabel · @Subtype(old)</small></td><td><strong>@Display(key.Name)</strong><small class="mono">@Display(key.Extension)</small></td><td class="mono">@Display(key.Value2)</td><td>@key.TypeLabel<small>@Subtype(key)</small></td><td>@key.Get("Line")</td><td><small>Media: @Display(key.Get("MediaType"))</small><small>Pickup: @Display(key.Get("PICKUP"))</small><small>Icon: @Display(key.Get("IconType"))</small></td><td><span class="@(Changed(key, old) ? "sb-changed-label" : "muted")">@(Changed(key, old) ? "Changed" : "Unchanged")</span></td></tr>
        }
        </tbody></table></div></article>
    }
    </section>
}
<details class="sb-history" open="@(_state.History.Count > 0)"><summary><span>Delivery history and backups <span class="count-label">@_state.History.Count</span></span><RadzenIcon Icon="expand_more" aria-hidden="true" /></summary>
    @if (_state.History.Count > 0) { <div class="table-wrap"><table><thead><tr><th>Created</th><th>Phone</th><th>Result</th><th>Details</th><th>Backup</th></tr></thead><tbody>@foreach (var item in _state.History) { <tr><td>@UiFormat.Date(item.CreatedAt)</td><td><strong>@PhoneName(item.PhoneId)</strong><small class="mono">@item.IpAddress</small></td><td><StatusBadge Status="@item.Status" /></td><td class="sb-history-message">@item.Message</td><td>@if (item.Status is "Success" or "Failed" or "Cancelled" or "TimedOut" or "Applying") { <AsyncButton Text="Preview restoration" Icon="restore" Disabled="@(Disabled || Dirty)" OnClick="() => RestoreAsync(item.Id)" /> } else { <span class="muted">—</span> }</td></tr> }</tbody></table></div> }
    else { <p class="sb-sidebar-note">Reviewed syncs and their backups will appear here.</p> }
    <footer class="sb-history-note"><RadzenIcon Icon="info" aria-hidden="true" /><span>A stopped sync may have updated earlier pages. Review the result before retrying or restoring.</span></footer>
</details>
</div>
@if (_editingKey is not null && _editor is not null) { <SwitchboardKeyDialog Key="_editingKey" Line="@SwitchboardEditing.PhoneLine(_editor.Baseline)" OnSaved="UseKey" OnCancel="() => _editingKey = null" /> }

@code {
    private SwitchboardState _state = new([], [], [], [], []);
    private SwitchboardEditor? _editor;
    private string _saved = "", _error = "", _working = "Loading switchboards…";
    private bool _busy, _alphabetical = true, _keepNumbers = true, _delivering;
    private int _addPhone, _page = 1;
    private SwitchboardKey? _editingKey;
    private CancellationTokenSource? _deliveryCancellation;
    private readonly HashSet<int> _selected = [];
    private readonly List<SwitchboardDeployment> _previews = [];
    private readonly List<string> _previewErrors = [];
    private readonly Dictionary<Guid, int> _previewPages = [];
    private bool Disabled => _busy || !RendererInfo.IsInteractive;
    private bool Dirty => _editor is not null && (_editor.Layout.Fingerprint() != _saved || _alphabetical != _editor.SortAlphabetically);
    private bool HasEmpty => _editor?.Layout.Keys.Any(k => k.Get("Type") == "0") == true;
    private IEnumerable<SwitchboardPhone> EligiblePhones => _state.Phones.Where(p => _state.FleetPhones.Any(f => f.Id == p.Id && f.Enabled));
    private IEnumerable<SelectOption<int>> FleetOptions => new[] { new SelectOption<int>(0, "Choose a fleet phone") }.Concat(_state.FleetPhones.Where(p => p.Enabled && _state.Phones.All(s => s.Id != p.Id)).Select(p => new SelectOption<int>(p.Id, $"{p.Name} · {p.IpAddress}")));
    private static IEnumerable<SelectOption<string>> TypeOptions(SwitchboardKey key) => SwitchboardKeyOptions.Types.Select(o => new SelectOption<string>(o.Value, o.Text)).Concat(SwitchboardKeyOptions.Types.Any(o => o.Value == key.Get("Type")) ? [] : new[] { new SelectOption<string>(key.Get("Type"), key.TypeLabel) });
    protected override Task OnInitializedAsync() => RefreshAsync();
    private Task RefreshAsync() => RunAsync("Loading switchboards…", async () => { await ReloadAsync(); if (_editor is null && EligiblePhones.FirstOrDefault() is { } first) { await LoadEditorAsync(first.Id); _selected.Add(first.Id); } else if (_editor is not null) await LoadEditorAsync(_editor.PhoneId); });
    private async Task ReloadAsync() { _state = await Keys.GetStateAsync(LifetimeToken); _selected.IntersectWith(EligiblePhones.Select(p => p.Id)); if (_editor is not null && EligiblePhones.All(p => p.Id != _editor.PhoneId)) { _editor = null; _saved = ""; } }
    private async Task BeforeNavigationAsync(LocationChangingContext context) { if (Dirty && !await Feedback.ConfirmAsync("Discard unsaved edits", "Your function-key changes have not been saved. Leave this page and discard them?", "Discard edits", ct: LifetimeToken)) context.PreventNavigation(); }
    private async Task LoadEditorAsync(int id) { _editor = await Keys.GetEditorAsync(id, LifetimeToken); _saved = _editor.Layout.Fingerprint(); _alphabetical = _editor.SortAlphabetically; _page = 1; }
    private Task OpenAsync(int id) => RunAsync("Opening layout…", async () => { if (!Dirty) await LoadEditorAsync(id); });
    private Task AddPhoneAsync() => RunAsync("Checking compatibility and reading five pages…", async () => { var id = _addPhone; await Keys.CaptureAsync(id, LifetimeToken); _addPhone = 0; await ReloadAsync(); await LoadEditorAsync(id); _selected.Add(id); Feedback.Notify("Phone added. All five pages are ready to edit.", "success"); });
    private Task ReadPhoneAsync() => RunAsync("Reading five pages from phone…", async () => { if (_editor is null || Dirty) return; if (!await Feedback.ConfirmAsync("Read keys from phone", "Replace this phone's saved layout with its current handset keys? This does not write to the handset.", "Read keys", ct: LifetimeToken)) return; await Keys.CaptureAsync(_editor.PhoneId, LifetimeToken); await ReloadAsync(); await LoadEditorAsync(_editor.PhoneId); });
    private Task RemovePhoneAsync() => RunAsync("Removing switchboard…", async () => { if (_editor is null || Dirty) return; if (!await Feedback.ConfirmAsync("Remove from switchboards", "Remove this phone and its saved layout? It stays in Phone fleet. Physical keys and delivery history are retained.", "Remove", ct: LifetimeToken)) return; await Keys.RemovePhoneAsync(_editor.PhoneId, LifetimeToken); _editor = null; _saved = ""; await ReloadAsync(); if (EligiblePhones.FirstOrDefault() is { } next) await LoadEditorAsync(next.Id); });
    private void Select(int id, bool value) { if (value) _selected.Add(id); else _selected.Remove(id); Invalidate(); }
    private void SelectAll() { if (_selected.Count == EligiblePhones.Count()) _selected.Clear(); else foreach (var p in EligiblePhones) _selected.Add(p.Id); Invalidate(); }
    private void Invalidate() { _previews.Clear(); _previewErrors.Clear(); _previewPages.Clear(); }
    private void ChangeText(SwitchboardKey key, string field, ChangeEventArgs e) { key.Fields[field] = e.Value?.ToString() ?? ""; Invalidate(); }
    private void ChangeNumber(SwitchboardKey key, ChangeEventArgs e, bool secondary) { var value = e.Value?.ToString() ?? ""; Invalidate(); if (value.Contains('|')) { _error = "Enter Value and Value2 separately, without pipe characters."; return; } _error = ""; key.Fields["Value"] = secondary ? key.Extension + (value.Length == 0 ? "" : "|" + value) : value + (key.Value2.Length == 0 ? "" : "|" + key.Value2); Invalidate(); }
    private void ChangeType(SwitchboardKey key, string type)
    {
        var copy = key with { Fields = new(key.Fields) };
        SwitchboardKeyOptions.ChangeType(copy, type, SwitchboardEditing.PhoneLine(_editor!.Baseline));
        if (SwitchboardKeyOptions.SubtypeField(copy).Length > 0 && type != "1") { _editingKey = copy; return; }
        key.Fields.Clear(); foreach (var field in copy.Fields) key.Fields[field.Key] = field.Value; Invalidate();
    }
    private void AddKey() { if (_editor?.Layout.Keys.FirstOrDefault(k => k.Get("Type") == "0") is not { } key) return; var copy = key with { Fields = new(key.Fields) }; copy.Fields["Type"] = "1"; copy.Fields["MemorySubType"] = "91"; copy.Fields["MediaType"] = "0"; _editingKey = copy; }
    private void UseKey(SwitchboardKey key) { var old = _editor!.Layout.Keys.Single(k => k.Page == key.Page && k.Slot == key.Slot); old.Fields.Clear(); foreach (var field in key.Fields) old.Fields[field.Key] = field.Value; _page = key.Page; _editingKey = null; Invalidate(); }
    private void SortKeys() { if (_editor is not null) _editor = _editor with { Layout = SwitchboardEditing.Sort(_editor.Layout) }; Invalidate(); }
    private Task DiscardAsync() => RunAsync("Discarding unsaved edits…", async () => { if (_editor is not null) await LoadEditorAsync(_editor.PhoneId); });
    private Task SaveAsync() => RunAsync("Saving layout…", SaveCoreAsync);
    private async Task SaveCoreAsync() { if (_editor is null) return; var layout = _alphabetical ? SwitchboardEditing.Sort(_editor.Layout) : _editor.Layout; _editor = await Keys.SaveDraftAsync(_editor.PhoneId, _editor.Revision, layout, _alphabetical, LifetimeToken); _saved = _editor.Layout.Fingerprint(); await ReloadAsync(); }
    private Task ReviewAsync(int[] ids) => RunAsync("Reading selected phones and preparing previews…", async () => { if (_editor is null) return; if (Dirty) await SaveCoreAsync(); foreach (var id in ids.Distinct()) { LifetimeToken.ThrowIfCancellationRequested(); try { _previews.Add(await Keys.PreviewDraftAsync(_editor.PhoneId, id, _keepNumbers, LifetimeToken)); } catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or TimeoutException) { _previewErrors.Add($"{PhoneName(id)}: {ex.Message}"); } await InvokeAsync(StateHasChanged); } await ReloadAsync(); });
    private Task RestoreAsync(Guid id) => RunAsync("Preparing restoration preview…", async () => { _previews.Add(await Keys.PreviewRestoreAsync(id, LifetimeToken)); await ReloadAsync(); });
    private Task DeployAsync() => RunAsync("Syncing and verifying keys…", async () =>
    {
        if (_previews.Count == 0 || _previewErrors.Count > 0 || Dirty) return;
        if (!await Feedback.ConfirmAsync("Sync reviewed function keys", $"Apply these reviewed layouts to {_previews.Count} phone(s)? Each phone is backed up and all five pages are verified. All 60 keys, including F1 and F2, can change as shown. Handset-wide settings are retained. A stopped sync may have updated earlier pages.", "Sync keys", ct: LifetimeToken)) return;
        using var stop = CancellationTokenSource.CreateLinkedTokenSource(LifetimeToken); _deliveryCancellation = stop; _delivering = true;
        try { for (var i = 0; i < _previews.Count; i++) { if (stop.IsCancellationRequested) break; _previews[i] = await Keys.DeployAsync(_previews[i].Id, stop.Token); await InvokeAsync(StateHasChanged); if (_previews[i].Status != "Success") break; } }
        finally { _delivering = false; _deliveryCancellation = null; }
        await ReloadAsync(); if (_editor is not null) await LoadEditorAsync(_editor.PhoneId);
    }, false);
    private void CancelDelivery() => _deliveryCancellation?.Cancel();
    private async Task RunAsync(string message, Func<Task> action, bool invalidate = true)
    {
        if (_busy || IsDisposed) return; _busy = true; _working = message; _error = ""; if (invalidate) Invalidate(); using var activity = BeginActivity(message);
        try { await action(); }
        catch (OperationCanceledException) when (LifetimeToken.IsCancellationRequested) { }
        catch (SwitchboardValidationException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Switchboard operation failed."); _error = ex is InvalidOperationException or InvalidDataException ? ex.Message : "The operation could not be completed. Check the phone connection and try again."; }
        finally { _busy = false; }
    }
    private string PhoneName(int id) => _state.FleetPhones.FirstOrDefault(p => p.Id == id)?.Name ?? $"Phone {id}";
    private static string Display(string value) => string.IsNullOrEmpty(value) ? "—" : value;
    private static bool Changed(SwitchboardKey a, SwitchboardKey b) => !SwitchboardEditing.SameKey(a, b);
    private static string Subtype(SwitchboardKey key) => SwitchboardKeyOptions.SubtypeLabel(key);
}
