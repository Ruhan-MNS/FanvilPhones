@page "/phones"
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject PhoneSyncService SyncSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Phones</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <div class="fp-section-header" style="margin-bottom: 0;">
        <span class="fp-section-icon"><MudIcon Icon="@Icons.Material.Filled.Smartphone" /></span>
        <div>
            <MudText Typo="Typo.h4">Phones</MudText>
        </div>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.TableView"
               Href="api/phones.xlsx" Target="_blank" Class="me-2">
        Export Excel
    </MudButton>
    <AuthorizeView Roles="Admin">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload"
                   HtmlTag="label" for="phonesXlsxUploadInput" Class="me-2">
            Import Excel
        </MudButton>
        <InputFile id="phonesXlsxUploadInput" OnChange="ImportXlsxAsync" accept=".xlsx" style="display:none" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Radar" OnClick="ScanAsync" Class="me-2">
            Scan network
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewAsync">
            Add phone
        </MudButton>
    </AuthorizeView>
</MudStack>
<div class="fp-section-subtitle">Each Fanvil handset on your network - credentials, upload endpoint, and last sync status.</div>

<div class="fp-table-wrap">
<MudTable Items="_phones" Dense="true" Hover="true" Bordered="false" Loading="_loading"
          Elevation="0">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>IP</MudTh>
        <MudTh>Username</MudTh>
        <MudTh>Upload Path</MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh>Last Sync</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Scheme://@context.IpAddress</MudTd>
        <MudTd>@context.Username</MudTd>
        <MudTd><code>@context.UploadPath</code></MudTd>
        <MudTd>
            <AuthorizeView Roles="Admin" Context="auth">
                <Authorized>
                    <MudSwitch T="bool" Value="context.Enabled" ValueChanged="@(v => ToggleEnabled(context, v))" Color="Color.Success" />
                </Authorized>
                <NotAuthorized>
                    <MudIcon Icon="@(context.Enabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                             Color="@(context.Enabled ? Color.Success : Color.Default)" />
                </NotAuthorized>
            </AuthorizeView>
        </MudTd>
        <MudTd>
            @if (context.LastSyncedAt is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Default">never</MudText>
            }
            else
            {
                <MudTooltip Text="@context.LastSyncMessage">
                    <MudChip T="string" Size="Size.Small"
                             Color="@StatusColor(context.LastSyncStatus)">
                        @context.LastSyncStatus @context.LastSyncedAt?.ToLocalTime().ToString("g")
                    </MudChip>
                </MudTooltip>
            }
        </MudTd>
        <MudTd Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Wifi" Size="Size.Small"
                           OnClick="@(() => ProbeAsync(context))" aria-label="Probe" />
            <AuthorizeView Roles="Admin" Context="auth">
                <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small"
                               OnClick="@(() => SyncOneAsync(context))" aria-label="Sync this phone" />
                <MudTooltip Text="@PushTooltip(context)">
                    <MudIconButton Icon="@Icons.Material.Filled.Badge" Size="Size.Small"
                                   OnClick="@(() => PushDisplayNameAsync(context))"
                                   Disabled="@(string.IsNullOrWhiteSpace(context.SipDisplayName)
                                               && string.IsNullOrWhiteSpace(context.SipExtension))"
                                   aria-label="Push SIP line settings" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditAsync(context))" aria-label="Edit" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" aria-label="Delete" />
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No phones yet. Click <b>Add phone</b> to start.</MudText>
    </NoRecordsContent>
</MudTable>
</div>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
    Defaults (<code>/pBookAdv.htm</code>, field <code>PHONEBOOK</code>) match Fanvil X-series
    phones and rarely need changing. Credentials default to <b>admin / admin</b>.
    Use <b>Probe</b> to verify a phone is reachable and the login works before syncing.
</MudAlert>

@code {
    private List<Phone> _phones = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _phones = await EntityFrameworkQueryableExtensions
            .ToListAsync(db.Phones.OrderBy(p => p.Name));
        _loading = false;
    }

    private static Color StatusColor(string? s) => s switch
    {
        "Success" => Color.Success,
        "Failed" => Color.Warning,
        "Error" => Color.Error,
        _ => Color.Default
    };

    private async Task ToggleEnabled(Phone p, bool v)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        p.Enabled = v;
        db.Phones.Update(p);
        await db.SaveChangesAsync();
    }

    private async Task AddNewAsync()
    {
        var parameters = new DialogParameters<PhoneEditDialog> { { x => x.Model, new Phone() } };
        var dlg = await Dialogs.ShowAsync<PhoneEditDialog>("Add phone", parameters);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: Phone p })
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                db.Phones.Add(p);
                await db.SaveChangesAsync();
                Snackbar.Add($"Added {p.Name}", Severity.Success);
                await LoadAsync();
            }
            catch (DbUpdateException ex) when (IsUniqueIpViolation(ex))
            {
                Snackbar.Add($"A phone with IP {p.IpAddress} already exists.", Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Could not save phone: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task ImportXlsxAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            var parsed = PhonesXlsx.Parse(ms);
            if (parsed.Count == 0)
            {
                Snackbar.Add("No phones found in that file.", Severity.Warning);
                return;
            }

            var mode = await Dialogs.ShowMessageBoxAsync(new MessageBoxOptions
            {
                Title = "Import phones",
                Message = $"Found {parsed.Count} phones in the file. " +
                          "Merge updates existing rows by IP and adds new ones. " +
                          "Replace deletes all current phones first.",
                YesText = "Merge",
                NoText = "Replace all",
                CancelText = "Cancel",
            });
            if (mode is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var added = 0;
            var updated = 0;

            if (mode == false)
            {
                db.Phones.RemoveRange(db.Phones);
                await db.SaveChangesAsync();
            }

            var existing = await db.Phones.ToListAsync();
            var byIp = existing.ToDictionary(p => p.IpAddress, StringComparer.OrdinalIgnoreCase);

            foreach (var p in parsed)
            {
                if (byIp.TryGetValue(p.IpAddress, out var tracked))
                {
                    tracked.Name = p.Name;
                    tracked.Scheme = p.Scheme;
                    tracked.Username = p.Username;
                    tracked.Password = p.Password;
                    tracked.UploadPath = p.UploadPath;
                    tracked.UploadFieldName = p.UploadFieldName;
                    tracked.Enabled = p.Enabled;
                    tracked.SipDisplayName = p.SipDisplayName;
                    tracked.SipLineIndex = p.SipLineIndex;
                    tracked.SipExtension = p.SipExtension;
                    tracked.SipRegistrationEnabled = p.SipRegistrationEnabled;
                    updated++;
                }
                else
                {
                    db.Phones.Add(p);
                    byIp[p.IpAddress] = p;
                    added++;
                }
            }
            await db.SaveChangesAsync();

            Snackbar.Add($"Imported: {added} added, {updated} updated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Import failed: " + ex.Message, Severity.Error);
        }
    }

    private async Task ScanAsync()
    {
        var dlg = await Dialogs.ShowAsync<ScanNetworkDialog>("Scan network",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var res = await dlg.Result;
        if (res is not { Canceled: false, Data: List<Phone> picks } || picks.Count == 0)
            return;

        var added = 0;
        var skipped = 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        foreach (var p in picks)
        {
            try
            {
                db.Phones.Add(p);
                await db.SaveChangesAsync();
                added++;
            }
            catch (DbUpdateException ex) when (IsUniqueIpViolation(ex))
            {
                skipped++;
                db.Entry(p).State = EntityState.Detached;
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Could not add {p.IpAddress}: {ex.Message}", Severity.Error);
                db.Entry(p).State = EntityState.Detached;
            }
        }

        if (added > 0)
            Snackbar.Add($"Added {added} phone{(added == 1 ? "" : "s")}" +
                         (skipped > 0 ? $" ({skipped} already existed)" : ""), Severity.Success);
        else if (skipped > 0)
            Snackbar.Add($"All {skipped} selected phones already existed.", Severity.Info);

        await LoadAsync();
    }

    private async Task EditAsync(Phone phone)
    {
        var copy = new Phone
        {
            Id = phone.Id, Name = phone.Name, IpAddress = phone.IpAddress,
            Username = phone.Username, Password = phone.Password, Scheme = phone.Scheme,
            UploadPath = phone.UploadPath, UploadFieldName = phone.UploadFieldName,
            Enabled = phone.Enabled,
            SipDisplayName = phone.SipDisplayName, SipLineIndex = phone.SipLineIndex,
            SipExtension = phone.SipExtension,
            SipRegistrationEnabled = phone.SipRegistrationEnabled,
        };
        var parameters = new DialogParameters<PhoneEditDialog> { { x => x.Model, copy } };
        var dlg = await Dialogs.ShowAsync<PhoneEditDialog>("Edit phone", parameters);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: Phone p })
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var tracked = await db.Phones.FindAsync(p.Id);
                if (tracked is null) return;
                tracked.Name = p.Name; tracked.IpAddress = p.IpAddress;
                tracked.Username = p.Username; tracked.Password = p.Password;
                tracked.Scheme = p.Scheme; tracked.UploadPath = p.UploadPath;
                tracked.UploadFieldName = p.UploadFieldName;
                tracked.SipDisplayName = p.SipDisplayName;
                tracked.SipLineIndex = p.SipLineIndex;
                tracked.SipExtension = p.SipExtension;
                tracked.SipRegistrationEnabled = p.SipRegistrationEnabled;
                await db.SaveChangesAsync();
                Snackbar.Add("Saved", Severity.Success);
                await LoadAsync();
            }
            catch (DbUpdateException ex) when (IsUniqueIpViolation(ex))
            {
                Snackbar.Add($"Another phone with IP {p.IpAddress} already exists.", Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Could not save phone: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task DeleteAsync(Phone phone)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete phone",
            $"Delete '{phone.Name}' ({phone.IpAddress})?",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Phones.Remove(phone);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private static bool IsUniqueIpViolation(DbUpdateException ex)
    {
        // SQLite reports unique violations via SqliteException with the constraint name in the message.
        var msg = ex.InnerException?.Message ?? ex.Message;
        return msg.Contains("UNIQUE", StringComparison.OrdinalIgnoreCase)
               && msg.Contains("IpAddress", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ProbeAsync(Phone phone)
    {
        Snackbar.Add($"Probing {phone.IpAddress}...", Severity.Info);
        var (ok, status, msg) = await SyncSvc.ProbeAsync(phone);
        Snackbar.Add($"{phone.Name}: {msg}", ok ? Severity.Success : Severity.Error);
    }

    private static string PushTooltip(Phone p)
    {
        var hasName = !string.IsNullOrWhiteSpace(p.SipDisplayName);
        var hasExt = !string.IsNullOrWhiteSpace(p.SipExtension);
        if (!hasName && !hasExt)
            return "No SIP display name or extension set";
        var parts = new List<string>();
        if (hasName) parts.Add($"display name '{p.SipDisplayName}'");
        if (hasExt) parts.Add($"username '{p.SipExtension}'");
        return $"Push {string.Join(" + ", parts)} to line {p.SipLineIndex}";
    }

    private async Task PushDisplayNameAsync(Phone phone)
    {
        var hasName = !string.IsNullOrWhiteSpace(phone.SipDisplayName);
        var hasExt = !string.IsNullOrWhiteSpace(phone.SipExtension);
        if (!hasName && !hasExt)
        {
            Snackbar.Add($"{phone.Name}: no SIP display name or extension configured. Edit the phone to set one.",
                Severity.Warning);
            return;
        }

        var parts = new List<string>();
        if (hasName) parts.Add($"display name = '{phone.SipDisplayName}'");
        if (hasExt) parts.Add($"username = '{phone.SipExtension}'");
        var what = string.Join(", ", parts);

        var ok = await Dialogs.ShowMessageBoxAsync("Push SIP line settings",
            $"Apply {what} to line {phone.SipLineIndex} of {phone.Name} ({phone.IpAddress})?\n\n" +
            "This modifies the phone's SIP line settings.",
            yesText: "Push", cancelText: "Cancel");
        if (ok != true) return;

        Snackbar.Add($"Pushing SIP line settings to {phone.Name}...", Severity.Info);
        var (success, message) = await SyncSvc.PushSipDisplayNameAsync(phone.Id);
        Snackbar.Add($"{phone.Name}: {message}", success ? Severity.Success : Severity.Error);
        await LoadAsync();
    }

    private async Task SyncOneAsync(Phone phone)
    {
        Snackbar.Add($"Syncing {phone.Name}...", Severity.Info);
        var r = await SyncSvc.SyncOneAsync(phone.Id);
        Snackbar.Add($"{phone.Name}: {r.Message}", r.Success ? Severity.Success : Severity.Error);
        await LoadAsync();
    }
}
