@inherits AsyncComponentBase
@inject ILogger<Phones> Logger
@page "/phones"
@attribute [Authorize]
@inject IPhoneDirectory Directory
@inject IPhoneSyncService SyncSvc
@inject UiFeedback Feedback

<PageTitle>Phone fleet · Fanvil Phones</PageTitle>
<PageHeader Title="Phone fleet" Description="Manage your handsets, connection details, and SIP identity.">
    <button class="button" @onclick="LoadAsync" disabled="@(!RendererInfo.IsInteractive || (_loading || _busy))"><RadzenIcon Icon="refresh" aria-hidden="true" />Refresh</button>
    <AuthorizeView Policy="@PhonePolicies.Administrator"><a class="button" href="/api/phones.xlsx"><RadzenIcon Icon="download" aria-hidden="true" />Export Excel</a><label class="button file-button @(_busy ? "is-disabled" : "")"><RadzenIcon Icon="upload" aria-hidden="true" />Import Excel<InputFile OnChange="ImportXlsxAsync" accept=".xlsx" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" aria-label="Import phones from Excel" /></label><button class="button" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" @onclick="() => _scanning = true"><RadzenIcon Icon="radar" aria-hidden="true" />Scan network</button><button class="button button--primary" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" @onclick="() => _editing = new Phone()"><RadzenIcon Icon="add" aria-hidden="true" />Add phone</button></AuthorizeView>
</PageHeader>
@if (_error is not null) { <div class="alert alert--danger" role="alert">@_error <button class="text-button" @onclick="LoadAsync">Try again</button></div> }
<div class="section-heading"><div><h2>Configured handsets <span class="count-label">@_phones.Count</span></h2><p>Probe a phone before delivering a new phonebook or applying SIP settings.</p></div></div>
<div class="table-toolbar">
    <div class="filter-tabs" role="group" aria-label="Filter phones">
        @foreach (var filter in new[] { "All phones", "Enabled", "Needs attention", "Disabled" }) { <button class="@(_filter == filter ? "is-active" : "")" aria-pressed="@(_filter == filter)" @onclick="() => SetFilter(filter)">@filter <span>@Count(filter)</span></button> }
    </div>
    <label class="search-field"><RadzenIcon Icon="search" aria-hidden="true" /><input type="search" placeholder="Search name, IP, extension…" aria-label="Search phones" @bind="_search" @bind:event="oninput" @bind:after="ResetPage" /></label>
</div>
<div class="table-wrap" aria-busy="@_loading"><table class="fleet-table"><thead><tr><th scope="col">Handset</th><th scope="col">Network address</th><th scope="col">SIP identity</th><th scope="col">Enabled</th><th scope="col">Last delivery</th><th scope="col" class="align-right">Actions</th></tr></thead><tbody>
    @if (_loading) { <tr><td colspan="6" class="empty-cell">Loading phones…</td></tr> }
    else if (Filtered.Count == 0) { <tr><td colspan="6" class="empty-cell"><RadzenIcon Icon="phone_in_talk" aria-hidden="true" /><strong>@(_phones.Count == 0 ? "Your fleet starts here" : "No matching handsets")</strong><span>@(_phones.Count == 0 ? "Add a phone or scan your network to get started." : "Try a different search or filter.")</span></td></tr> }
    @foreach (var phone in Paged) {
        <tr @key="phone.Id"><td><strong class="cell-title">@phone.Name</strong><small>@phone.Username · @phone.UploadPath</small></td><td><a class="mono device-link" href="@($"{(phone.Scheme == "https" ? "https" : "http")}://{phone.IpAddress}")" target="_blank" rel="noopener noreferrer" title="Open handset web interface">@phone.IpAddress <RadzenIcon Icon="open_in_new" aria-hidden="true" /></a><small>@phone.Scheme.ToUpperInvariant()</small></td><td>@(string.IsNullOrWhiteSpace(phone.SipDisplayName) ? "Not configured" : phone.SipDisplayName)<small>Extension @(phone.SipExtension ?? "—") · Line @phone.SipLineIndex</small></td>
        <td><AuthorizeView Policy="@PhonePolicies.Administrator" Context="enabledAuth"><Authorized><label class="toggle"><input type="checkbox" checked="@phone.Enabled" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" aria-label="@($"Enable {phone.Name} for sync")" @onchange="args => ToggleAsync(phone, args.Value is true)" /><span aria-hidden="true"></span><span>@(phone.Enabled ? "On" : "Off")</span></label></Authorized><NotAuthorized><span class="badge">@(phone.Enabled ? "Enabled" : "Disabled")</span></NotAuthorized></AuthorizeView></td>
        <td title="@phone.LastSyncMessage"><StatusBadge Status="@(phone.LastSyncedAt is null ? "Pending" : phone.LastSyncStatus)" /><small>@UiFormat.Date(phone.LastSyncedAt)</small></td>
        <td><div class="row-actions"><button class="icon-button" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" title="Probe connection" aria-label="@($"Probe {phone.Name}")" @onclick="() => ProbeAsync(phone)"><RadzenIcon Icon="wifi_tethering" aria-hidden="true" /></button><AuthorizeView Policy="@PhonePolicies.Administrator" Context="actionAuth"><button class="icon-button" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" title="Sync phonebook" aria-label="@($"Sync {phone.Name}")" @onclick="() => SyncOneAsync(phone)"><RadzenIcon Icon="sync" aria-hidden="true" /></button><button class="icon-button" disabled="@(!RendererInfo.IsInteractive || (_busy || !HasSip(phone)))" title="Push SIP settings" aria-label="@($"Push SIP settings to {phone.Name}")" @onclick="() => PushAsync(phone)"><RadzenIcon Icon="badge" aria-hidden="true" /></button><button class="icon-button" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" title="Edit phone" aria-label="@($"Edit {phone.Name}")" @onclick="() => Edit(phone)"><RadzenIcon Icon="edit" aria-hidden="true" /></button><button class="icon-button icon-button--danger" disabled="@(!RendererInfo.IsInteractive || (_busy || _loading))" title="Delete phone" aria-label="@($"Delete {phone.Name}")" @onclick="() => DeleteAsync(phone)"><RadzenIcon Icon="delete_outline" aria-hidden="true" /></button></AuthorizeView></div></td></tr>
    }
</tbody></table></div>
<TablePager Total="@Filtered.Count" @bind-Page="_page" @bind-PageSize="_pageSize" />
<aside class="help-note"><RadzenIcon Icon="info" aria-hidden="true" /><div><strong>Built for Fanvil X-series</strong><p>The default upload path is <code>/pBookAdv.htm</code> with field <code>PHONEBOOK</code>. Handset credentials are separate from your employee login.</p></div></aside>
@if (_editing is not null) { <PhoneEditDialog Model="_editing" OnSaved="SavedAsync" OnCancel="() => _editing = null" /> }
@if (_scanning) { <ScanNetworkDialog OnAdded="AddDiscoveredAsync" OnCancel="() => _scanning = false" /> }
@code {
    private List<Phone> _phones = [];
    private Phone? _editing;
    private bool _loading = true, _busy, _scanning;
    private string? _error;
    private string _search = "", _filter = "All phones";
    private int _page = 1, _pageSize = 25;
    private static bool NeedsAttention(Phone p) => p.Enabled && p.LastSyncedAt is not null && p.LastSyncStatus != "Success";
    private static bool HasSip(Phone p) => !string.IsNullOrWhiteSpace(p.SipDisplayName) || !string.IsNullOrWhiteSpace(p.SipExtension);
    private bool InFilter(Phone p, string filter) => filter switch { "Enabled" => p.Enabled, "Disabled" => !p.Enabled, "Needs attention" => NeedsAttention(p), _ => true };
    private int Count(string filter) => _phones.Count(p => InFilter(p, filter));
    private List<Phone> Filtered => _phones.Where(p => InFilter(p, _filter) && (string.IsNullOrWhiteSpace(_search) || new[] { p.Name, p.IpAddress, p.SipExtension, p.SipDisplayName }.Any(v => v?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true))).ToList();
    private IEnumerable<Phone> Paged => Filtered.Skip((Math.Clamp(_page, 1, Math.Max(1, (int)Math.Ceiling((double)Filtered.Count / _pageSize))) - 1) * _pageSize).Take(_pageSize);
    private void ResetPage() => _page = 1;
    private void SetFilter(string filter) { _filter = filter; ResetPage(); }
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { if (!TryBeginLoad()) return; _loading = true; _error = null; try { _phones = await Directory.GetPhonesAsync(LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); } catch (OperationCanceledException) when (LifetimeToken.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load the phone fleet."); _error = "Phones could not be loaded. Please try again."; } finally { _loading = false; EndLoad(); } }
    private void Edit(Phone p) => _editing = new Phone { Id = p.Id, Name = p.Name, IpAddress = p.IpAddress, Scheme = p.Scheme, Username = p.Username, Password = p.Password, UploadPath = p.UploadPath, UploadFieldName = p.UploadFieldName, Enabled = p.Enabled, SipDisplayName = p.SipDisplayName, SipLineIndex = p.SipLineIndex, SipExtension = p.SipExtension, SipRegistrationEnabled = p.SipRegistrationEnabled };
    private async Task SavedAsync() { _editing = null; await LoadAsync(); }
    private async Task RunAsync(Func<Task> operation, [System.Runtime.CompilerServices.CallerMemberName] string operationName = "")
    { if (_busy || IsDisposed) return; _busy = true; try { await operation(); } catch (OperationCanceledException) when (LifetimeToken.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "Phone operation {Operation} failed.", operationName); Feedback.Notify("The action could not be completed. Check the connection and try again.", "danger"); } finally { _busy = false; } }
    private Task ToggleAsync(Phone p, bool enabled) => RunAsync(async () => { await Directory.SetPhoneEnabledAsync(p.Id, enabled, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); p.Enabled = enabled; Feedback.Notify($"{p.Name} is now {(enabled ? "enabled" : "disabled")} for fleet sync.", "success"); });
    private Task DeleteAsync(Phone p) => RunAsync(async () => { if (!await Feedback.ConfirmAsync("Delete phone", $"Remove {p.Name} ({p.IpAddress}) and its activity history? This cannot be undone.", "Delete phone", true, ct: LifetimeToken)) return; await Directory.DeletePhoneAsync(p.Id, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify($"Removed {p.Name}.", "success"); await LoadAsync(); });
    private Task ProbeAsync(Phone p) => RunAsync(async () => { Feedback.Notify($"Probing {p.Name}…"); var (ok, _, message) = await SyncSvc.ProbeAsync(p, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify($"{p.Name}: {message}", ok ? "success" : "danger"); });
    private Task SyncOneAsync(Phone p) => RunAsync(async () => { Feedback.Notify($"Syncing the phonebook to {p.Name}…"); var result = await SyncSvc.SyncOneAsync(p.Id, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify($"{p.Name}: {result.Message}", result.Success ? "success" : "danger"); await LoadAsync(); });
    private Task PushAsync(Phone p) => RunAsync(async () => { if (!await Feedback.ConfirmAsync("Push SIP settings", $"Apply display name '{p.SipDisplayName}' and extension '{p.SipExtension}' to line {p.SipLineIndex} on {p.Name}? This changes the handset configuration.", "Apply settings", ct: LifetimeToken)) return; var (ok, message) = await SyncSvc.PushSipDisplayNameAsync(p.Id, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify(message, ok ? "success" : "danger"); await LoadAsync(); });
    private Task ImportXlsxAsync(InputFileChangeEventArgs args) => RunAsync(async () => {
        using var stream = new MemoryStream(); await args.File.OpenReadStream(10 * 1024 * 1024).CopyToAsync(stream, LifetimeToken); stream.Position = 0;
        var parsed = PhonesXlsx.Parse(stream, LifetimeToken); if (parsed.Count == 0) { Feedback.Notify("No phone records were found in this workbook.", "warning"); return; }
        var choice = await Feedback.ChooseAsync("Import phones", $"Found {parsed.Count} phones. Merge matches by IP address. Replace removes the current fleet and its activity history before importing.", "Merge phones", "Replace entire fleet", ct: LifetimeToken);
        if (choice == DialogChoice.Cancel) return;
        var result = await Directory.ImportPhonesAsync(parsed, choice == DialogChoice.Secondary, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify($"Imported {result.Added} new phones and updated {result.Updated}.", "success"); await LoadAsync();
    });
    private Task AddDiscoveredAsync(List<Phone> phones) => RunAsync(async () => {
        _scanning = false; var added = 0; var skipped = 0;
        foreach (var phone in phones) { try { await Directory.SavePhoneAsync(phone, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); added++; } catch (DuplicatePhoneException) { skipped++; } }
        Feedback.Notify($"Added {added} phones. {skipped} already existed.", "success"); await LoadAsync();
    });
}
