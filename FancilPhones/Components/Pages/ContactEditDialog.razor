@inherits AsyncComponentBase
@inject ILogger<ContactEditDialog> Logger
@inject IPhoneDirectory Directory
@inject UiFeedback Feedback
<AppDialog Open="true" Title="@(Model.Id == 0 ? "Add contact" : "Edit contact")" Description="This contact will be included in the next phonebook delivery." Busy="@_busy" OnClose="OnCancel">
    <EditForm Model="Model" OnValidSubmit="SaveAsync" FormName="contact-editor"><DataAnnotationsValidator />
        <div class="dialog-body"><ValidationSummary />
            @if (_error is not null) { <div class="alert alert--danger" role="alert">@_error</div> }
            <fieldset disabled="@_busy"><legend>Contact details</legend><div class="form-grid">
                <label class="field field--wide">Display name<TextFieldInput @bind-Value="Model.DisplayName" placeholder="Jane Doe" required maxlength="128" /><ValidationMessage For="() => Model.DisplayName" /></label>
                <label class="field">Office number<TextFieldInput @bind-Value="Model.OfficeNumber" type="tel" maxlength="64" /></label><label class="field">Mobile number<TextFieldInput @bind-Value="Model.MobileNumber" type="tel" maxlength="64" /></label>
                <label class="field field--wide">Other number<TextFieldInput @bind-Value="Model.OtherNumber" type="tel" maxlength="64" /></label>
            </div></fieldset>
            <fieldset disabled="@_busy"><legend>Organization & ringtone</legend><div class="form-grid"><label class="field">Group<TextFieldInput @bind-Value="Model.Group" placeholder="Staff" maxlength="64" /></label><label class="field">Ring<TextFieldInput @bind-Value="Model.Ring" placeholder="Auto" maxlength="16" /><small>Use Auto for the handset's default ringtone.</small></label></div></fieldset>
        </div>
        <footer class="dialog-footer"><button type="button" class="button" disabled="@_busy" @onclick="OnCancel">Cancel</button><AsyncButton Type="submit" Class="button button--primary" Text="Save contact" BusyText="Saving…" Icon="save" Busy="_busy" /></footer>
    </EditForm>
</AppDialog>
@code {
    [Parameter, EditorRequired] public Contact Model { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private bool _busy;
    private string? _error;
    private async Task SaveAsync() { if (_busy || IsDisposed) return; _busy = true; _error = null; using var activity = BeginActivity("Saving contact…"); try { await Directory.SaveContactAsync(Model, LifetimeToken); LifetimeToken.ThrowIfCancellationRequested(); Feedback.Notify($"Saved {Model.DisplayName}.", "success"); await OnSaved.InvokeAsync(); } catch (OperationCanceledException) when (LifetimeToken.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save contact {ContactId}.", Model.Id); _error = "The contact could not be saved. Check the details and try again."; } finally { _busy = false; } }
}
