<AppDialog Open="true" Title="@($"Edit Page {Key.Page} · F{Key.Slot}")" Description="Choose a key type, then configure its settings. Changes are applied only after a reviewed sync." OnClose="OnCancel">
    <div class="dialog-body">
        @if (_error is not null) { <div class="alert alert--danger" role="alert">@_error</div> }
        <div class="form-grid">
            <div class="field"><span>Type</span><WorkspaceSelect TValue="string" Options="@Options(SwitchboardKeyOptions.Types, "Type")" Value="@_key.Get("Type")" ValueChanged="SetType" Label="Key type" /></div>
            <label class="field">Name<input maxlength="63" value="@_key.Name" @oninput='e => Set("Title", e)' /></label>
            @if (SwitchboardKeyOptions.SubtypeField(_key).Length > 0)
            {
                <div class="field field--wide"><span>@SubtypeCaption</span><WorkspaceSelect TValue="string" Options="@Options(SwitchboardKeyOptions.Subtypes(_key), SwitchboardKeyOptions.SubtypeField(_key))" Value="@_key.Get(SwitchboardKeyOptions.SubtypeField(_key))" ValueChanged="SetSubtype" Label="Key subtype" /></div>
            }
            @if (SwitchboardKeyOptions.DetailField(_key).Length > 0)
            {
                <div class="field field--wide"><span>@(SwitchboardKeyOptions.DetailField(_key) == "PttSubTypeValue" ? "Multicast codec" : "Contact group")</span><WorkspaceSelect TValue="string" Options="@Options(SwitchboardKeyOptions.Details(_key), SwitchboardKeyOptions.DetailField(_key))" Value="@_key.Get(SwitchboardKeyOptions.DetailField(_key))" ValueChanged="SetDetail" Label="Key subtype details" /></div>
            }
            @if (SwitchboardKeyOptions.HasValue(_key))
            {
                <label class="field">@ValueCaption<input maxlength="@SwitchboardKeyOptions.ValueLimit(_key)" value="@_key.Extension" placeholder="@ValuePlaceholder" @oninput="e => SetNumber(e, false)" /></label>
                <label class="field">Value2<input maxlength="@SwitchboardKeyOptions.ValueLimit(_key)" value="@_key.Value2" @oninput="e => SetNumber(e, true)" /><small>Optional secondary value.</small></label>
            }
            @if (SwitchboardKeyOptions.HasLine(_key))
            {
                <div class="field"><span>SIP line</span><WorkspaceSelect TValue="string" Options="LineOptions" Value="@_key.Get("Line")" ValueChanged='v => SetValue("Line", v)' Label="Key SIP line" /><small>Primary-line assignments adapt to each target phone. Explicit SIP lines and Auto are retained.</small></div>
            }
            @if (_key.Get("Type") == "1")
            {
                <div class="field"><span>Media</span><WorkspaceSelect TValue="string" Options="@Options(SwitchboardKeyOptions.Media, "MediaType")" Value="@_key.Get("MediaType")" ValueChanged='v => SetValue("MediaType", v)' Label="Key media" /></div>
                <label class="field">Pickup number<input maxlength="31" value="@_key.Get("PICKUP")" @oninput='e => Set("PICKUP", e)' /></label>
            }
            <div class="field"><span>Icon color</span><WorkspaceSelect TValue="string" Options="@Options(SwitchboardKeyOptions.Icons, "IconType")" Value="@_key.Get("IconType")" ValueChanged='v => SetValue("IconType", v)' Label="Key icon color" /></div>
        </div>
        <p class="field-hint key-editor-hint">Name: 63 UTF-8 bytes. @(SwitchboardKeyOptions.ValueLimit(_key) == 127 ? "URL values: up to 127 bytes each." : "Value and Value2 combined: 31 bytes.")</p>
    </div>
    <footer class="dialog-footer"><button type="button" class="button" @onclick="OnCancel">Cancel</button><button type="button" class="button button--primary" @onclick="Save">Use key</button></footer>
</AppDialog>
@code {
    [Parameter, EditorRequired] public SwitchboardKey Key { get; set; } = null!;
    [Parameter, EditorRequired] public string Line { get; set; } = "1";
    [Parameter] public EventCallback<SwitchboardKey> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private SwitchboardKey _key = null!;
    private string? _error;
    private bool _invalidValue, _invalidValue2;
    protected override void OnInitialized() => _key = Key with { Fields = new(Key.Fields) };
    private IEnumerable<SelectOption<string>> Options(IEnumerable<KeyOption> options, string field) => options.Select(o => new SelectOption<string>(o.Value, o.Text)).Concat(options.Any(o => o.Value == _key.Get(field)) ? [] : new[] { new SelectOption<string>(_key.Get(field), string.IsNullOrEmpty(_key.Get(field)) ? "None (captured)" : $"Captured ({_key.Get(field)})") });
    private IEnumerable<SelectOption<string>> LineOptions => new[] { new SelectOption<string>("-1", "Auto") }.Concat(Enumerable.Range(1, 20).Select(n => new SelectOption<string>(n.ToString(), $"SIP {n}" + (n.ToString() == Line ? " (primary)" : "")))).Append(new("23", "Mobile"));
    private string SubtypeCaption => _key.Get("Type") switch { "3" => "Key event", "14" => "Multicast codec", "20" => "HTTP method", "24" => "PTT mode", _ => "Subtype" };
    private string ValueCaption => _key.Get("Type") is "7" or "20" or "21" ? "URL" : _key.Get("Type") is "14" or "22" || _key.Get("Type") == "24" && _key.Get("PttSubType") == "14" ? "Multicast address" : _key.Get("Type") == "4" ? "DTMF sequence" : "Value";
    private string ValuePlaceholder => ValueCaption switch { "URL" => "https://…", "Multicast address" => "Multicast IP address:port", _ => "" };
    private void SetValue(string field, string value) { _error = null; _key.Fields[field] = value; }
    private void Set(string field, ChangeEventArgs e) => SetValue(field, e.Value?.ToString() ?? "");
    private void SetNumber(ChangeEventArgs e, bool secondary)
    {
        var value = e.Value?.ToString() ?? "";
        if (secondary) _invalidValue2 = value.Contains('|'); else _invalidValue = value.Contains('|');
        if (value.Contains('|')) { _error = "Enter Value and Value2 separately, without pipe characters."; return; }
        _error = null;
        _key.Fields["Value"] = secondary ? _key.Extension + (value.Length == 0 ? "" : "|" + value) : value + (_key.Value2.Length == 0 ? "" : "|" + _key.Value2);
    }
    private void SetType(string type) { _error = null; if (type != _key.Get("Type")) _invalidValue = _invalidValue2 = false; SwitchboardKeyOptions.ChangeType(_key, type, Line); }
    private void SetSubtype(string value) { _error = null; SwitchboardKeyOptions.ChangeSubtype(_key, value); if (!SwitchboardKeyOptions.HasValue(_key)) _invalidValue = _invalidValue2 = false; }
    private void SetDetail(string value) => SetValue(SwitchboardKeyOptions.DetailField(_key), value);
    private Task Save()
    {
        if (SwitchboardKeyOptions.HasValue(_key) && (_invalidValue || _invalidValue2)) { _error = "Enter Value and Value2 separately, without pipe characters."; return Task.CompletedTask; }
        if (_error is not null) return Task.CompletedTask;
        if (_key.Get("Type") == "1" && string.IsNullOrWhiteSpace(_key.Name)) _error = "Enter a name for this Memory Key.";
        else if (SwitchboardKeyOptions.HasValue(_key) && string.IsNullOrWhiteSpace(_key.Extension)) _error = $"Enter a {ValueCaption.ToLowerInvariant()} for this key.";
        else if (System.Text.Encoding.UTF8.GetByteCount(_key.Name) > 63 || System.Text.Encoding.UTF8.GetByteCount(_key.Get("Value")) > SwitchboardKeyOptions.CombinedValueLimit(_key) || System.Text.Encoding.UTF8.GetByteCount(_key.Get("PICKUP")) > 31)
            _error = "The name or value exceeds this key type's field limit. Shorten it before continuing.";
        return _error is null ? OnSaved.InvokeAsync(_key) : Task.CompletedTask;
    }
}
