@page "/account/change-password"
@attribute [Authorize]
<PageTitle>My account · Fanvil Phones</PageTitle>
<PageHeader Title="My account" Description="Your employee identity, connected to the voice workspace." />
<AuthorizeView Context="account"><section class="panel account-panel"><div class="panel-heading"><div><h2>@account.User.Identity?.Name</h2><p>Multinet Systems employee account</p></div><RadzenIcon Icon="account_circle" aria-hidden="true" /></div><div class="panel-body"><div class="alert"><RadzenIcon Icon="verified_user" aria-hidden="true" /><span>Authentication is managed centrally in ASP Auth, using the same account as BIDevHub.</span></div><h3>Password & account assistance</h3><p>Contact your identity administrator for password changes, resets, or authenticator setup. Changes to your shared account apply to every connected platform.</p></div><div class="panel-footer"><a class="text-link" href="/">Return to overview <RadzenIcon Icon="arrow_forward" aria-hidden="true" /></a></div></section></AuthorizeView>
