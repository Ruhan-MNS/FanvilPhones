@page "/account/change-password"
@attribute [Authorize]
@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Change password</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-6">
    <MudCard Elevation="0" Class="fp-card-surface pa-2">
        <MudCardContent>
            <div class="fp-section-header">
                <span class="fp-section-icon" style="background: rgba(79, 70, 229, 0.10); color: #4F46E5;">
                    <MudIcon Icon="@Icons.Material.Filled.Password" />
                </span>
                <div>
                    <MudText Typo="Typo.h5">Change password</MudText>
                    @if (_mustChange)
                    {
                        <MudText Typo="Typo.caption" Style="color: #B45309;">
                            You must set a new password before continuing.
                        </MudText>
                    }
                </div>
            </div>

            <MudForm @ref="_form" Class="mt-4">
                <MudTextField @bind-Value="_current" Label="Current password"
                              InputType="InputType.Password" Required="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudTextField @bind-Value="_new" Label="New password"
                              InputType="InputType.Password" Required="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              HelperText="At least 4 characters." />
                <MudTextField @bind-Value="_confirm" Label="Confirm new password"
                              InputType="InputType.Password" Required="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2">@_error</MudAlert>
                }
            </MudForm>
        </MudCardContent>
        <MudCardActions>
            <MudSpacer />
            <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save" Disabled="_busy">
                @(_busy ? "Saving..." : "Update password")
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm? _form;
    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;
    private bool _mustChange;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var name = state.User.Identity?.Name;
        if (name is null) return;
        var u = await UserManager.FindByNameAsync(name);
        _mustChange = u?.MustChangePassword ?? false;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_new != _confirm) { _error = "New password and confirmation do not match."; return; }
        if (string.IsNullOrWhiteSpace(_new) || _new.Length < 4) { _error = "Password must be at least 4 characters."; return; }

        _busy = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var name = state.User.Identity?.Name;
            if (name is null) { _error = "Not signed in."; return; }
            var user = await UserManager.FindByNameAsync(name);
            if (user is null) { _error = "User not found."; return; }

            var res = await UserManager.ChangePasswordAsync(user, _current, _new);
            if (!res.Succeeded)
            {
                _error = string.Join(" ", res.Errors.Select(e => e.Description));
                return;
            }

            if (user.MustChangePassword)
            {
                user.MustChangePassword = false;
                await UserManager.UpdateAsync(user);
            }

            Snackbar.Add("Password updated.", Severity.Success);
            Nav.NavigateTo("/", forceLoad: false);
        }
        finally { _busy = false; }
    }
}
